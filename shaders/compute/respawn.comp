#version 430 core
layout (local_size_x = 64) in;

struct Particle {
    vec2 position;
    vec2 velocity;
    vec4 color;
    float mass;
    uint respawn;
    float spawnDelay;
};

layout(std430, binding = 0) buffer ParticleBuffer {
    Particle particles[];
};

uniform int numParticles;
uniform int frameIndex;
uniform int respawnAll;
uniform float dt;
uniform float spawnDelayDuration;
uniform vec2 spawnPosMin;
uniform vec2 spawnPosMax;
uniform vec2 spawnVelMin;
uniform vec2 spawnVelMax;
uniform float spawnMassMin;
uniform float spawnMassMax;
uniform float spawnBlueMin;
uniform float spawnBlueMax;

uint hash_u32(uint x) {
    x ^= x >> 16;
    x *= 0x7feb352du;
    x ^= x >> 15;
    x *= 0x846ca68bu;
    x ^= x >> 16;
    return x;
}

float toUnit(uint h) {
    return float(h >> 8) * (1.0 / 16777216.0);
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(numParticles)) return;
    if (respawnAll != 0) {
        particles[i].respawn = 1u;
        particles[i].spawnDelay = -1.0;
        particles[i].mass = 0.0;
    }
    if (particles[i].respawn == 0u) return;

    particles[i].mass = 0.0;
    if (particles[i].spawnDelay < 0.0) {
        particles[i].spawnDelay = spawnDelayDuration
            * float(i) / float(max(numParticles - 1, 1));
    }
    particles[i].spawnDelay = max(particles[i].spawnDelay - dt, 0.0);
    if (particles[i].spawnDelay > 0.0) return;

    uint s = hash_u32(i ^ hash_u32(uint(frameIndex) + 0x9e3779b9u));

    uint h0 = hash_u32(s);
    uint h1 = hash_u32(h0 + 0x9e3779b9u);
    uint h2 = hash_u32(h1 + 0x9e3779b9u);
    uint h3 = hash_u32(h2 + 0x9e3779b9u);
    uint h4 = hash_u32(h3 + 0x9e3779b9u);
    uint h5 = hash_u32(h4 + 0x9e3779b9u);

    vec2  p  = mix(spawnPosMin, spawnPosMax, vec2(toUnit(h0), toUnit(h1)));
    vec2  v  = mix(spawnVelMin, spawnVelMax, vec2(toUnit(h2), toUnit(h3)));
    float m  = mix(spawnMassMin, spawnMassMax, toUnit(h4));
    float cb = mix(spawnBlueMin, spawnBlueMax, toUnit(h5));

    particles[i].position = p;
    particles[i].velocity = v;
    particles[i].color    = vec4(0.2, 0.5, cb, 1.0);
    particles[i].mass     = m;
    particles[i].respawn  = 0u;
    particles[i].spawnDelay = -1.0;
}
