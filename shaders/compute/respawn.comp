#version 430 core
layout (local_size_x = 64) in;

struct Particle {
    vec2 position;
    vec2 velocity;
    vec4 color;
    float mass;
    uint respawn;
};

layout(std430, binding = 0) buffer ParticleBuffer {
    Particle particles[];
};

uniform int numParticles;
uniform int frameIndex;
uniform int respawnAll;
uniform vec2 spawnPosMin;
uniform vec2 spawnPosMax;
uniform vec2 spawnVelMin;
uniform vec2 spawnVelMax;
uniform float spawnMassMin;
uniform float spawnMassMax;
uniform float spawnBlueMin;
uniform float spawnBlueMax;

uint hash_u32(uint x) {
    x ^= x >> 16;
    x *= 0x7feb352du;
    x ^= x >> 15;
    x *= 0x846ca68bu;
    x ^= x >> 16;
    return x;
}

float rand01(uint seed) {
    return float(hash_u32(seed)) / 4294967295.0;
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(numParticles)) return;

    if (respawnAll == 0 && particles[i].respawn == 0u) return;

    uint base = i + uint(frameIndex) * 747796405u;

    vec2 p = mix(spawnPosMin, spawnPosMax, vec2(rand01(base + 11u), rand01(base + 23u)));
    vec2 v = mix(spawnVelMin, spawnVelMax, vec2(rand01(base + 37u), rand01(base + 43u)));
    float m = mix(spawnMassMin, spawnMassMax, rand01(base + 59u));
    float cb = mix(spawnBlueMin, spawnBlueMax, rand01(base + 71u));

    particles[i].position = p;
    particles[i].velocity = v;
    particles[i].color = vec4(0.2, 0.5, cb, 1.0);
    particles[i].mass = m;
    particles[i].respawn = 0u;
}
